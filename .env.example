# Copy this file to ".env" and fill it in. Leave the email lines empty to run in test mode.

# MongoDB connection string (see the setup steps). Add the database name "safeher" before the "?".
# Atlas example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/safeher?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/safeher
MONGODB_URI=

# For Gmail: turn on 2-step verification, then create an "App password"
# (Google Account > Security > App passwords). Use that, not your normal password.
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=your-16-letter-app-password
PORT=3000

# Any long random text. It signs the login tokens, so keep it private.
JWT_SECRET=change-this-to-a-long-random-text
